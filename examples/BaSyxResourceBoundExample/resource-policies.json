{
  "ResourceBoundAccessRuleModels": [
    {
      "RESOURCE": {
        "ROUTE": "/shells"
      },
      "rules": [
        {
          "ACL": {
            "ATTRIBUTES": [
              {
                "CLAIM": "iss"
              },
              {
                "CLAIM": "sub"
              }
            ],
            "RIGHTS": [
              "ALL"
            ],
            "ACCESS": "ALLOW"
          },
          "FORMULA": {
            "$and": [
              {
                "$eq": [
                  {
                    "$attribute": {
                      "CLAIM": "iss"
                    }
                  },
                  {
                    "$strVal": "https://issuer.example"
                  }
                ]
              },
              {
                "$eq": [
                  {
                    "$attribute": {
                      "CLAIM": "sub"
                    }
                  },
                  {
                    "$strVal": "bridge-owner"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "RESOURCE": {
        "ROUTE": "/submodels"
      },
      "rules": [
        {
