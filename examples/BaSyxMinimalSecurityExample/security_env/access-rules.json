{
  "AllAccessPermissionRules": {
    "DEFATTRIBUTES": [
      { "name": "anonymous", "attributes": [{ "GLOBAL": "ANONYMOUS" }] },
      { "name": "role", "attributes": [{ "CLAIM": "role" }] }
    ],
    "DEFOBJECTS": [
      {
        "name": "public_service_information",
        "objects": [{ "ROUTE": "/description" }, { "ROUTE": "/health" }]
      },
      {
        "name": "concept_description_catalog",
        "objects": [
          { "ROUTE": "/concept-descriptions" },
          { "ROUTE": "/concept-descriptions/*" },
          { "IDENTIFIABLE": "$cd(\"*\")" }
        ]
      },
      {
        "name": "resource_collections",
        "objects": [
          { "ROUTE": "/shells" },
          { "ROUTE": "/submodels" },
          { "ROUTE": "/shell-descriptors" },
          { "ROUTE": "/submodel-descriptors" },
          { "ROUTE": "/concept-descriptions" },
          { "ROUTE": "/lookup/shells" },
          { "ROUTE": "/lookup/shellsByAssetLink" }
        ]
      },
      {
        "name": "all_resources",
        "objects": [
          { "IDENTIFIABLE": "$aas(\"*\")" },
          { "IDENTIFIABLE": "$sm(\"*\")" },
          { "IDENTIFIABLE": "$cd(\"*\")" },
          { "DESCRIPTOR": "$aasdesc(\"*\")" },
          { "DESCRIPTOR": "$smdesc(\"*\")" }
        ]
      },
      {
        "name": "abac_policy_management",
        "objects": [{ "ROUTE": "/security/abac" }, { "ROUTE": "/security/abac/*" }]
      }
    ],
    "DEFACLS": [
      { "name": "anonymous_read", "acl": { "USEATTRIBUTES": "anonymous", "RIGHTS": ["READ"], "ACCESS": "ALLOW" } },
      { "name": "role_read", "acl": { "USEATTRIBUTES": "role", "RIGHTS": ["READ"], "ACCESS": "ALLOW" } },
      { "name": "role_collection", "acl": { "USEATTRIBUTES": "role", "RIGHTS": ["CREATE", "READ"], "ACCESS": "ALLOW" } },
      { "name": "role_all", "acl": { "USEATTRIBUTES": "role", "RIGHTS": ["ALL"], "ACCESS": "ALLOW" } }
    ],
    "DEFFORMULAS": [
      { "name": "is_viewer", "formula": { "$eq": [{ "$attribute": { "CLAIM": "role" } }, { "$strVal": "viewer" }] } },
      { "name": "is_admin", "formula": { "$eq": [{ "$attribute": { "CLAIM": "role" } }, { "$strVal": "admin" }] } }
    ],
    "rules": [
      { "USEACL": "anonymous_read", "USEOBJECTS": ["public_service_information"], "FORMULA": { "$boolean": true } },
      { "USEACL": "role_read", "USEOBJECTS": ["concept_description_catalog"], "USEFORMULA": "is_viewer" },
      { "USEACL": "role_collection", "USEOBJECTS": ["resource_collections"], "USEFORMULA": "is_viewer" },
      { "USEACL": "role_all", "USEOBJECTS": ["resource_collections", "all_resources", "abac_policy_management"], "USEFORMULA": "is_admin" }
    ]
  }
}
