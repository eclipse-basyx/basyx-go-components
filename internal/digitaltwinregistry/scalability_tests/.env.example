# Existing external PostgreSQL database containing the large DTR descriptor data set.
DTR_SCALE_POSTGRES_HOST=host.docker.internal
DTR_SCALE_POSTGRES_PORT=7432
DTR_SCALE_POSTGRES_USER=postgres
DTR_SCALE_POSTGRES_PASSWORD=change-me
DTR_SCALE_POSTGRES_DBNAME=postgres
DTR_SCALE_POSTGRES_SSLMODE=disable

# Local Keycloak database; it is created by this Compose setup only.
DTR_SCALE_KEYCLOAK_DB_PASSWORD=keycloak

# Request workload. Each individual request has a strict 10-second timeout.
DTR_SCALE_REQUEST_REPETITIONS=1
DTR_SCALE_REQUEST_CONCURRENCY=2
DTR_SCALE_PAGE_LIMIT=50
# Disabled by default because successful async bulk scenarios write temporary
# descriptors and permanent audit/history entries to the external database.
DTR_SCALE_ASYNC_BULK_ENABLED=false
DTR_SCALE_ASYNC_BULK_SIZE=10
DTR_SCALE_ASYNC_BULK_TIMEOUT_SECONDS=30
DTR_SCALE_ASYNC_BULK_POLL_INTERVAL_MILLISECONDS=100
DTR_SCALE_ASSET_ID_NAME=manufacturerPartId
DTR_SCALE_SECOND_ASSET_ID_NAME=customerPartId
# These are the users from the DTR integration-test realm. They exercise full,
# viewer, clearance, no-BPN, and editor permission profiles.
DTR_SCALE_KEYCLOAK_USERS=admin,usera,userb,no_bpn_viewer,userx,usery
DTR_SCALE_KEYCLOAK_REFERENCE_USER=admin
DTR_SCALE_KEYCLOAK_PASSWORD=pwd
# Adds an unauthenticated user named "anonymous". Its requests have no
# Authorization header and exercise the public-read access rules.
DTR_SCALE_INCLUDE_ANONYMOUS=true

# Sample fixtures. Regenerate them against the same database that DTR uses.
# Run scripts/dtr_scalability_fixtures to replace them with a fresh sample.
DTR_SCALE_FIXTURE_COUNT=5
