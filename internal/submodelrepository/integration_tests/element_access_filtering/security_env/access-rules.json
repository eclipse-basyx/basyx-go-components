{
  "AllAccessPermissionRules": {
    "DEFATTRIBUTES": [
      {
        "name": "role_attr",
        "attributes": [
          {
            "CLAIMPATH": "/role"
          }
        ]
      }
    ],
    "DEFOBJECTS": [
      {
        "name": "everything",
        "objects": [
          {
            "IDENTIFIABLE": "$aas(\"*\")"
          },
          {
            "IDENTIFIABLE": "$sm(\"*\")"
          },
          {
            "IDENTIFIABLE": "$cd(\"*\")"
          }
        ]
      },
      {
        "name": "b_objects",
        "objects": [
          {
            "REFERABLE": "$sme(\"urn:uuid:design-example-001\").GearRatio"
          }
        ]
      },
      {
        "name": "nested_first",
        "objects": [
          {
            "REFERABLE": "$sme(\"urn:uuid:design-example-001\").Group.Allowed"
          }
        ]
      },
      {
        "name": "nested_second",
        "objects": [
          {
            "REFERABLE": "$sme(\"urn:uuid:design-example-001\").OtherGroup.Second"
          }
        ]
      }
    ],
    "DEFACLS": [
      {
        "name": "token_all",
        "acl": {
          "USEATTRIBUTES": "role_attr",
          "RIGHTS": [
            "ALL"
          ],
          "ACCESS": "ALLOW"
        }
      },
      {
        "name": "token_read",
        "acl": {
          "USEATTRIBUTES": "role_attr",
          "RIGHTS": [
            "READ"
          ],
          "ACCESS": "ALLOW"
        }
      }
    ],
    "DEFFORMULAS": [
      {
        "name": "is_provider",
        "formula": {
          "$contains": [
            {
              "$attribute": {
                "CLAIMPATH": "/role"
              }
            },
            {
              "$strVal": "add_digital_twin"
            }
          ]
        }
      },
      {
        "name": "bpn_b",
        "formula": {
          "$and": [
            {
              "$contains": [
                {
                  "$attribute": {
                    "CLAIMPATH": "/role"
                  }
                },
                {
                  "$strVal": "view_digital_twin"
                }
              ]
            },
            {
              "$eq": [
                {
                  "$attribute": {
                    "CLAIM": "Edc-Bpn"
                  }
                },
                {
                  "$strVal": "BPNL00000003AZQP"
                }
              ]
            }
          ]
        }
      },
      {
        "name": "first_condition",
        "formula": {
          "$and": [
            {
              "$contains": [
                {
                  "$attribute": {
                    "CLAIMPATH": "/role"
                  }
                },
                {
                  "$strVal": "view_digital_twin"
                }
              ]
            },
            {
              "$or": [
                {
                  "$eq": [
                    {
                      "$attribute": {
                        "CLAIM": "Edc-Bpn"
                      }
                    },
                    {
                      "$strVal": "NESTED_FIRST"
                    }
                  ]
                },
                {
                  "$eq": [
                    {
                      "$attribute": {
                        "CLAIM": "Edc-Bpn"
                      }
                    },
                    {
                      "$strVal": "NESTED_BOTH"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "name": "second_condition",
        "formula": {
          "$and": [
            {
              "$contains": [
                {
                  "$attribute": {
                    "CLAIMPATH": "/role"
                  }
                },
                {
                  "$strVal": "view_digital_twin"
                }
              ]
            },
            {
              "$or": [
                {
                  "$eq": [
                    {
                      "$attribute": {
                        "CLAIM": "Edc-Bpn"
                      }
                    },
                    {
                      "$strVal": "NESTED_SECOND"
                    }
                  ]
                },
                {
                  "$eq": [
                    {
                      "$attribute": {
                        "CLAIM": "Edc-Bpn"
                      }
                    },
                    {
                      "$strVal": "NESTED_BOTH"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "rules": [
      {
        "USEACL": "token_all",
        "USEOBJECTS": [
          "everything"
        ],
        "USEFORMULA": "is_provider"
      },
      {
        "USEACL": "token_read",
        "USEOBJECTS": [
          "b_objects"
        ],
        "USEFORMULA": "bpn_b"
      },
      {
        "USEACL": "token_read",
        "USEOBJECTS": [
          "nested_first"
        ],
        "USEFORMULA": "first_condition"
      },
      {
        "USEACL": "token_read",
        "USEOBJECTS": [
          "nested_second"
        ],
        "USEFORMULA": "second_condition"
      }
    ]
  }
}
