{
  "realm": "element-access-filtering",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "element-access-filtering",
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "role",
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "Edc-Bpn",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "Edc-Bpn",
            "claim.name": "Edc-Bpn",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "element-access-filtering",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
