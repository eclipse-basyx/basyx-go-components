model
  schema 1.1

type user

type group
  relations
    define member: [user]

type repository
  relations
    define admin: [user, group#member]
    define creator: [user, group#member] or admin

type aas
  relations
    define owner: [user, group#member]
    define editor: [user, group#member]
    define viewer: [user, group#member]
    define executor: [user, group#member]
    define can_manage: owner
    define can_delete: owner
    define can_update: editor or owner
    define can_read: viewer or can_update
    define can_execute: executor or owner

type submodel
  relations
    define linked_aas: [aas]
    define owner: [user, group#member]
    define editor: [user, group#member]
    define viewer: [user, group#member]
    define executor: [user, group#member]
    define can_manage: owner
    define can_delete: owner
    define can_update: editor or owner or can_update from linked_aas
    define can_read: viewer or can_update or can_read from linked_aas
    define can_execute: executor or owner or can_execute from linked_aas

type element
  relations
    define submodel: [submodel]
    define parent: [element]
    define owner: [user, group#member]
    define editor: [user, group#member]
    define viewer: [user, group#member]
    define executor: [user, group#member]
    define can_manage: owner or can_manage from parent or can_manage from submodel
    define can_update: editor or can_manage or can_update from parent or can_update from submodel
    define can_read: viewer or can_update or can_read from parent or can_read from submodel
    define can_execute: executor or can_manage or can_execute from parent or can_execute from submodel

type concept_description
  relations
    define owner: [user, group#member]
    define editor: [user, group#member]
    define viewer: [user, group#member]
    define can_manage: owner
    define can_delete: owner
    define can_update: editor or owner
    define can_read: viewer or can_update
