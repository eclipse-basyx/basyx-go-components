{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admin-shell.io/events/schemas/pcnNotificationEvent.v1.schema.json",
  "title": "PCN Notification Event - data payload",
  "description": "JSON Schema for the 'data' field of a CloudEvent of type 'io.admin-shell.pcn.v1'. The payload carries the asset identification plus a single Record of the IDTA Submodel Template 'ProductChangeNotifications' (IDTA 02036-1-0), serialized in format 'Value' (Value-Only) per IDTA-01003. A Record is a SubmodelElementCollection and is therefore serialized as an unnamed JSON object; required properties are derived from the SMT/Cardinality qualifiers (One, OneToMany).",
  "type": "object",
  "properties": {
    "globalAssetIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "Global identifiers of all assets this notification applies to. Corresponds to AssetInformation.globalAssetId. A submodel may be shared across multiple assets."
    },
    "semanticId": {
      "$ref": "#/$defs/Reference",
      "description": "Optional. Semantic ID of the submodel the record originates from, as an AAS Reference object. Typically an ExternalReference with a GlobalReference key pointing to the IRI of the submodel template."
    },
    "record": {
      "$ref": "#/$defs/Record",
      "description": "One entry of the PCN submodel's 'Records' SubmodelElementList, in Value-Only serialization."
    }
  },
  "$defs": {
    "Record": {
      "title": "PCN Record (ValueOnly)",
      "description": "SubmodelElementCollection 'Record' of the Records list, serialized as an unnamed JSON object.",
      "type": "object",
      "properties": {
        "Manufacturer": { "$ref": "#/$defs/Manufacturer" },
        "ManufacturerChangeID": {
          "type": "string",
          "description": "Property, xs:string. Cardinality ZeroToOne."
        },
        "PcnType": {
          "type": "string",
          "description": "Property, xs:string. Cardinality One. Global flag distinguishing PCN from PDN (VDMA 24903).",
          "enum": ["PCN", "PDN"]
        },
        "LifeCycleData": {
          "type": "array",
          "description": "SubmodelElementList of Milestone (SMC). Cardinality ZeroToOne; order is preserved.",
          "items": { "$ref": "#/$defs/Milestone" }
        },
        "ReasonsOfChange": {
          "type": "array",
          "description": "SubmodelElementList of ReasonOfChange (SMC). Cardinality One, list entries OneToMany. At least one reason according to VDMA 24903 shall be given.",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ReasonOfChange" }
        },
        "ItemCategories": {
          "type": "array",
          "description": "SubmodelElementList of ItemCategory (SMC). Cardinality One, list entries OneToMany. At least one item category according to VDMA 24903 shall be given.",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ItemCategory" }
        },
        "AffectedPartNumbers": {
          "type": "array",
          "description": "SubmodelElementList of Property (xs:string). Cardinality ZeroToOne. Single numbers ('12345'), sets ('12345;23456'), ranges ('10000-19999'), wildcards '*' and '?' are allowed. Only to be given if not the full range of part numbers is affected.",
          "items": { "type": "string" }
        },
        "PcnReasonComment": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality ZeroToOne. May be substituted by PcnChangeInformation."
        },
        "PcnChangeInformation": { "$ref": "#/$defs/PcnChangeInformation" },
        "AdditionalInformation": {
          "type": "array",
          "description": "SubmodelElementList of File. Cardinality ZeroToOne. Attachments such as conventional product change information documents.",
          "items": { "$ref": "#/$defs/File" }
        },
        "DateOfRecord": {
          "type": "string",
          "format": "date-time",
          "description": "Property, xs:dateTime. Cardinality One. UTC date (and typically time) at which the record was initially published."
        },
        "ItemOfChange": { "$ref": "#/$defs/ItemOfChange" },
        "RecommendedItems": {
          "type": "array",
          "description": "SubmodelElementList of RecommendedItem (SMC). Cardinality ZeroToOne.",
          "items": { "$ref": "#/$defs/RecommendedItem" }
        }
      },
      "required": [
        "Manufacturer",
        "PcnType",
        "ReasonsOfChange",
        "ItemCategories",
        "PcnChangeInformation",
        "DateOfRecord",
        "ItemOfChange"
      ],
      "additionalProperties": false
    },
    "MultiLanguageProperty": {
      "title": "MultiLanguageProperty (ValueOnly)",
      "description": "Serialized as an array of single-entry JSON objects; the property name is the language code (two chars, ISO 639-1), the value the localized string.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$" },
        "additionalProperties": { "type": "string" }
      }
    },
    "Reference": {
      "title": "Reference (format 'Normal')",
      "description": "References are serialized in format 'Normal' even inside a ValueOnly payload.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ExternalReference", "ModelReference"]
        },
        "referredSemanticId": { "$ref": "#/$defs/Reference" },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "AnnotatedRelationshipElement", "AssetAdministrationShell", "BasicEventElement",
                  "Blob", "Capability", "ConceptDescription", "DataElement", "Entity",
                  "EventElement", "File", "FragmentReference", "GlobalReference",
                  "Identifiable", "MultiLanguageProperty", "Operation", "Property", "Range",
                  "Referable", "ReferenceElement", "RelationshipElement", "Submodel",
                  "SubmodelElement", "SubmodelElementCollection", "SubmodelElementList"
                ]
              },
              "value": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "keys"],
      "additionalProperties": false
    },
    "File": {
      "title": "File (ValueOnly)",
      "type": "object",
      "properties": {
        "contentType": { "type": "string" },
        "value": {
          "type": "string",
          "description": "Path or URL of the referenced file."
        }
      },
      "required": ["contentType"],
      "additionalProperties": false
    },
    "ArbitraryValue": {
      "description": "Value of an arbitrary DataElement (Property, MultiLanguageProperty or Range) whose idShort and semanticId are not fixed by the template.",
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "$ref": "#/$defs/MultiLanguageProperty" },
        {
          "type": "object",
          "title": "Range (ValueOnly)",
          "properties": {
            "min": { "type": ["string", "number", "null"] },
            "max": { "type": ["string", "number", "null"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "Manufacturer": {
      "title": "Manufacturer",
      "description": "SubmodelElementCollection. Cardinality One.",
      "type": "object",
      "properties": {
        "ManufacturerName": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality One."
        },
        "PhysicalAddress": {
          "type": "object",
          "description": "SubmodelElementCollection. Cardinality One. Content is defined by the SMT drop-in 'Contact Information' (V1.0 or V1.1); its elements are therefore not constrained here beyond being valid Value-Only values.",
          "additionalProperties": { "$ref": "#/$defs/ArbitraryValue" }
        }
      },
      "required": ["ManufacturerName", "PhysicalAddress"],
      "additionalProperties": false
    },
    "Milestone": {
      "title": "Milestone",
      "description": "SubmodelElementCollection inside LifeCycleData. Cardinality ZeroToMany.",
      "type": "object",
      "properties": {
        "MilestoneClassification": {
          "type": "string",
          "description": "Property, xs:string. Cardinality One. PDN is not used here; it is expressed via PcnType.",
          "enum": ["SOP", "NRND", "PCN", "EOS", "EOP", "LTD", "EOSR"]
        },
        "DateOfValidity": {
          "type": "string",
          "format": "date-time",
          "description": "Property, xs:dateTime. Cardinality One. UTC date at which the change takes place."
        }
      },
      "required": ["MilestoneClassification", "DateOfValidity"],
      "additionalProperties": false
    },
    "ReasonOfChange": {
      "title": "ReasonOfChange",
      "type": "object",
      "properties": {
        "ReasonClassificationSystem": {
          "type": "string",
          "description": "Property, xs:string. Cardinality One.",
          "examples": ["VDMA24903", "ECLASS"]
        },
        "VersionOfClassificationSystem": {
          "type": "string",
          "description": "Property, xs:string. Cardinality ZeroToOne.",
          "examples": ["2017"]
        },
        "ReasonId": {
          "type": "string",
          "description": "Property, xs:string. Cardinality One.",
          "examples": ["RAWM"]
        }
      },
      "required": ["ReasonClassificationSystem", "ReasonId"],
      "additionalProperties": false
    },
    "ItemCategory": {
      "title": "ItemCategory",
      "type": "object",
      "properties": {
        "ItemClassificationSystem": {
          "type": "string",
          "description": "Property, xs:string. Cardinality One.",
          "examples": ["VDMA24903"]
        },
        "VersionOfClassificationSystem": {
          "type": "string",
          "description": "Property, xs:string. Cardinality ZeroToOne.",
          "examples": ["2017"]
        },
        "ItemCategory": {
          "type": "string",
          "description": "Property, xs:string. Cardinality One.",
          "examples": ["ELME"]
        }
      },
      "required": ["ItemClassificationSystem", "ItemCategory"],
      "additionalProperties": false
    },
    "PcnChangeInformation": {
      "title": "PcnChangeInformation",
      "description": "SubmodelElementCollection. Cardinality One.",
      "type": "object",
      "properties": {
        "ChangeTitle": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality One."
        },
        "ChangeDetail": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality One."
        }
      },
      "required": ["ChangeTitle", "ChangeDetail"],
      "additionalProperties": false
    },
    "ProductClassification": {
      "title": "ProductClassification",
      "type": "object",
      "properties": {
        "ClassificationSystem": {
          "type": "string",
          "description": "Property, xs:string. Cardinality One.",
          "examples": ["ECLASS"]
        },
        "VersionOfClassificationSystem": {
          "type": "string",
          "description": "Property, xs:string. Cardinality ZeroToOne.",
          "examples": ["14.0 (BASIC)"]
        },
        "ProductClassId": {
          "type": "string",
          "description": "Property, xs:string. Cardinality One.",
          "examples": ["27-27-49-01"]
        }
      },
      "required": ["ClassificationSystem", "ProductClassId"],
      "additionalProperties": false
    },
    "SingleChange": {
      "title": "SingleChange",
      "description": "SubmodelElementCollection inside TechnicalData_Changes. Contains one arbitrary DataElement carrying the new value (marked by supplementalSemanticId 'NewValue'), plus an optional back-reference and reason.",
      "type": "object",
      "properties": {
        "OriginOfChange": {
          "$ref": "#/$defs/Reference",
          "description": "ReferenceElement. Cardinality ZeroToOne. Back-reference to the element in the technical data submodel where the change originates."
        },
        "ReasonId": {
          "type": "string",
          "description": "Property, xs:string. Cardinality ZeroToOne.",
          "examples": ["RAWM"]
        }
      },
      "additionalProperties": { "$ref": "#/$defs/ArbitraryValue" }
    },
    "TechnicalDataGroup": {
      "title": "TechnicalData_Fit / _Form / _Function / _Other",
      "description": "SubmodelElementCollection with an optional TargetEstimate plus arbitrary technical DataElements.",
      "type": "object",
      "properties": {
        "TargetEstimate": {
          "type": "number",
          "description": "Property, xs:float. Cardinality ZeroToOne. Degree of match to the item of change, 0.0 (not suitable) to 1.0 (equal performance).",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": { "$ref": "#/$defs/ArbitraryValue" }
    },
    "ItemOfChange": {
      "title": "ItemOfChange",
      "description": "SubmodelElementCollection. Cardinality One.",
      "type": "object",
      "properties": {
        "ManufacturerProductFamily": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality One."
        },
        "ManufacturerProductDesignation": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality One."
        },
        "OrderCodeOfManufacturer": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality ZeroToOne (may not exist for long-term used items)."
        },
        "ManufacturerAssetID": {
          "$ref": "#/$defs/Reference",
          "description": "ReferenceElement. Cardinality ZeroToOne."
        },
        "ProductClassifications": {
          "type": "array",
          "description": "SubmodelElementList of ProductClassification (SMC). Cardinality ZeroToOne.",
          "items": { "$ref": "#/$defs/ProductClassification" }
        },
        "HardwareVersion": {
          "type": "string",
          "description": "Property, xs:string. Cardinality ZeroToOne.",
          "examples": ["1.1"]
        },
        "RemainingAmountAvailable": {
          "type": ["integer", "string"],
          "description": "Property, xs:positiveInteger. Cardinality ZeroToOne. Serialized as a JSON number; a string is permitted for values exceeding safe JSON number precision.",
          "minimum": 1,
          "pattern": "^\\+?[1-9][0-9]*$",
          "examples": [4500]
        },
        "TechnicalData_Changes": {
          "type": "array",
          "description": "SubmodelElementList of SingleChange (SMC). Cardinality ZeroToOne.",
          "items": { "$ref": "#/$defs/SingleChange" }
        },
        "TechnicalData_CurrentState": {
          "type": "object",
          "description": "SubmodelElementCollection. Cardinality ZeroToOne. Contains arbitrary DataElements mirroring the properties given for the recommended items.",
          "additionalProperties": { "$ref": "#/$defs/ArbitraryValue" }
        }
      },
      "required": ["ManufacturerProductFamily", "ManufacturerProductDesignation"],
      "additionalProperties": false
    },
    "RecommendedItem": {
      "title": "RecommendedItem",
      "description": "SubmodelElementCollection inside RecommendedItems. Cardinality ZeroToMany.",
      "type": "object",
      "properties": {
        "ManufacturerProductFamily": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality One."
        },
        "ManufacturerProductDesignation": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality One."
        },
        "OrderCodeOfManufacturer": {
          "$ref": "#/$defs/MultiLanguageProperty",
          "description": "MultiLanguageProperty. Cardinality One (required in order to place an order)."
        },
        "ProductClassifications": {
          "type": "array",
          "description": "SubmodelElementList of ProductClassification (SMC). Cardinality ZeroToOne.",
          "items": { "$ref": "#/$defs/ProductClassification" }
        },
        "TechnicalData_Fit": { "$ref": "#/$defs/TechnicalDataGroup" },
        "TechnicalData_Form": { "$ref": "#/$defs/TechnicalDataGroup" },
        "TechnicalData_Function": { "$ref": "#/$defs/TechnicalDataGroup" },
        "TechnicalData_Other": { "$ref": "#/$defs/TechnicalDataGroup" },
        "IncotermCode": {
          "type": "string",
          "description": "Property, xs:string. Cardinality ZeroToOne. INCOTERMS code.",
          "examples": ["DAT"]
        },
        "DeliveryTimeClassSameRegion": {
          "type": "integer",
          "description": "Property, xs:int. Cardinality ZeroToOne. Expected delivery duration in working days, same region.",
          "examples": [2]
        },
        "DeliveryTimeClassOtherRegion": {
          "type": "integer",
          "description": "Property, xs:int. Cardinality ZeroToOne. Expected delivery duration in working days, other regions.",
          "examples": [5]
        },
        "ConformityDeclarations": {
          "type": "object",
          "description": "SubmodelElementCollection. Cardinality ZeroToOne. Contains arbitrary SubmodelElements.",
          "additionalProperties": true
        }
      },
      "required": [
        "ManufacturerProductFamily",
        "ManufacturerProductDesignation",
        "OrderCodeOfManufacturer"
      ],
      "additionalProperties": false
    }
  }
}
